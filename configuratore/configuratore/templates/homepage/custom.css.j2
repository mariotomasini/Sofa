/* FILE GENERATO DA MEDIABOX — il Pannello ha lo stile di Cerca (stessi colori e caratteri). */
@font-face { font-family: "Atkinson Hyperlegible Next"; font-weight: 200 800; font-display: swap;
  src: url("/cerca/static/fonts/atkinson-hyperlegible-next-latin.woff2") format("woff2"); }

:root { --mb-sfondo: #161513; --mb-pannello: #1c1a18; --mb-pannello-2: #262421; --mb-testo: #efe9de; --mb-tenue: #aaa398; --mb-accento: #f2b45a; }

html, body, #page_wrapper, #page_container { background: var(--mb-sfondo) !important; }
body, body * { font-family: "Atkinson Hyperlegible Next", system-ui, sans-serif !important; }
body { color: var(--mb-testo); }

/* titoli dei gruppi */
.services-group h2, #services h2 { color: var(--mb-testo) !important; font-weight: 500 !important; font-size: 1.2rem !important; }

/* tessere dei servizi */
.service-card, li.service > div {
  background: var(--mb-pannello) !important; border-radius: 14px !important; border: 1px solid rgb(239 233 222 / .08);
  box-shadow: none !important; transition: transform .15s ease;
}
.service-card:hover, li.service > div:hover { background: var(--mb-pannello-2) !important; }
.service-name, .service-title { font-weight: 500 !important; font-size: 1.05rem !important; color: var(--mb-testo) !important; }
.service-description { color: var(--mb-tenue) !important; font-size: .9rem !important; }

/* la riga "Guarda": tessere più grandi, Jellyfin in evidenza */
li.service[data-name="Jellyfin"] > div, li.service[data-name="Torna a Cerca"] > div, li.service[data-name="Kids"] > div {
  min-height: 92px; display: flex; align-items: center;
}
/* in cima: il ritorno a Cerca, la pagina principale, nel colore della lampada */
li.service[data-name="Torna a Cerca"] > div { background: var(--mb-accento) !important; }
li.service[data-name="Torna a Cerca"] .service-name,
li.service[data-name="Torna a Cerca"] .service-description { color: #1f1407 !important; }

/* i numeri dal vivo dei download */
.service-block { background: var(--mb-pannello-2) !important; border-radius: 10px !important; }

/* focus del telecomando */
a:focus-visible, button:focus-visible { outline: 3px solid #fff !important; outline-offset: 3px; border-radius: 14px; }
@media (prefers-reduced-motion: reduce) { * { transition: none !important; } }
