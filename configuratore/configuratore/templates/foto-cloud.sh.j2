#!/bin/sh
# -----------------------------------------------------------------------------
#  FILE GENERATO DA MEDIABOX — non modificarlo a mano.
#  Copia delle foto nel cloud, cifrata sul PC con restic prima di partire: chi
#  gestisce il cloud vede solo dati illeggibili. Ogni notte manda solo le foto nuove.
#  Tiene anche le versioni passate (7 giorni, 8 settimane, 24 mesi): una foto
#  cancellata per sbaglio si recupera.
#
#  Dal PC si usa con "mediabox foto-cloud":
#    collega      (Storage Box di Hetzner) installa la chiave, una volta sola
#    stato        le copie nel cloud, una per notte
#    ripristina   riporta l'ultima copia in MEDIA_DIR/foto-ripristinate
#  Con altri argomenti esegue restic e basta (es. "snapshots", "check").
# -----------------------------------------------------------------------------
set -u

CHIAVE=/chiave/id_ed25519

prepara_ssh() {
	# Storage Box di Hetzner: SFTP sulla porta 23 con una chiave creata qui la prima volta
	[ -n "${STORAGEBOX_UTENTE:-}" ] || return 0
	mkdir -p /root/.ssh /chiave
	[ -f "$CHIAVE" ] || ssh-keygen -q -t ed25519 -N "" -C "mediabox-foto" -f "$CHIAVE"
	cat > /root/.ssh/config <<FINE
Host storagebox
	HostName ${STORAGEBOX_HOST}
	User ${STORAGEBOX_UTENTE}
	Port 23
	IdentityFile ${CHIAVE}
	IdentitiesOnly yes
	UserKnownHostsFile /chiave/known_hosts
	StrictHostKeyChecking accept-new
	ServerAliveInterval 60
	ServerAliveCountMax 10
FINE
	chmod 600 /root/.ssh/config
}

collegato() {
	# vero se lo Storage Box accetta la chiave (senza chiedere password)
	ssh -o BatchMode=yes -o ConnectTimeout=20 storagebox ls > /dev/null 2>&1
}

collega() {
	if [ -z "${STORAGEBOX_UTENTE:-}" ]; then
		echo "Serve solo per lo Storage Box di Hetzner (FOTO_STORAGEBOX nel file .env)."
		return 1
	fi
	if collegato; then
		echo "Lo Storage Box accetta già la chiave di mediabox: niente da fare."
	else
		echo "Installo la chiave di mediabox sullo Storage Box ${STORAGEBOX_UTENTE}."
		echo "Scrivi la password dello Storage Box (la trovi nella pagina di Hetzner): serve solo adesso."
		ssh -p 23 -o StrictHostKeyChecking=accept-new -o UserKnownHostsFile=/chiave/known_hosts \
			"${STORAGEBOX_UTENTE}@${STORAGEBOX_HOST}" install-ssh-key < "${CHIAVE}.pub" || {
			echo "Non è andata. Controlla nella pagina dello Storage Box che \"SSH\" sia attivo e la password giusta."
			return 1
		}
		collegato || { echo "La chiave non funziona ancora: riprova tra un minuto."; return 1; }
	fi
	restic cat config > /dev/null 2>&1 || restic init || return 1
	echo "Fatto: ogni notte alle ${ORA_COPIA:-3} le foto nuove vanno sullo Storage Box, cifrate."
}

prepara_ssh
case "${1:-}" in
	"") ;;
	collega) collega; exit $? ;;
	stato) exec restic snapshots --compact ;;
	ripristina) exec restic restore latest --target /ripristino ;;
	*) exec restic "$@" ;;
esac

ORA="${ORA_COPIA:-3}"
STATO=/stato

avvisa() {
	[ -n "${NTFY_TOPIC:-}" ] || return 0
	wget -q -O /dev/null --header "Title: $1" --header "Tags: camera" \
		--post-data "$2" "${NTFY_SERVER:-https://ntfy.sh}/${NTFY_TOPIC}" || true
}

scrivi_stato() {
	# per Cerca (pagina Controllo servizi): esito e data dell'ultima copia
	printf '%s\n%s\n' "$1" "$(date '+%Y-%m-%d %H:%M')" > "$STATO/ultima.tmp" && mv "$STATO/ultima.tmp" "$STATO/ultima"
}

copia() {
	if [ -n "${STORAGEBOX_UTENTE:-}" ] && ! collegato; then
		echo "Lo Storage Box non accetta la chiave: sul PC scrivi \"mediabox foto-cloud collega\""
		return 1
	fi
	if ! restic cat config > /dev/null 2>&1; then
		echo "Prima copia: preparo lo spazio nel cloud"
		restic init || return 1
	fi
	cartelle=""
	for c in library upload profile backups; do
		[ -d "/foto/$c" ] && cartelle="$cartelle /foto/$c"
	done
	[ -n "$cartelle" ] || { echo "Ancora nessuna foto da copiare"; return 0; }
	limite=""
	[ -n "${LIMITE_KB:-}" ] && limite="--limit-upload ${LIMITE_KB}"
	# shellcheck disable=SC2086
	restic backup --tag foto --exclude-caches $limite $cartelle || return 1
	# la domenica si fa ordine (costa qualche richiesta in più al cloud)
	if [ "$(date +%u)" = "7" ]; then
		restic forget --tag foto --keep-daily 7 --keep-weekly 8 --keep-monthly 24 --prune || return 1
		# un piccolo controllo che i dati nel cloud si leggano davvero (1% ogni settimana)
		restic check --read-data-subset=1% || return 1
	else
		restic forget --tag foto --keep-daily 7 --keep-weekly 8 --keep-monthly 24 || return 1
	fi
}

mkdir -p "$STATO"
echo "Copia delle foto nel cloud: ogni notte alle ${ORA}"
while true; do
	oggi="$(date +%Y-%m-%d)"
	ora="$(date +%H | sed 's/^0//')"
	fatta="$(cat "$STATO/giorno" 2>/dev/null || true)"
	if [ "$ora" = "$ORA" ] && [ "$fatta" != "$oggi" ]; then
		echo "$oggi" > "$STATO/giorno"
		if copia; then
			echo "Copia riuscita"
			if [ ! -f "$STATO/prima-fatta" ]; then
				touch "$STATO/prima-fatta"
				avvisa "Foto al sicuro nel cloud" "La prima copia completa delle foto nel cloud è finita. Da ora ogni notte copio solo quelle nuove."
			fi
			scrivi_stato ok
		else
			scrivi_stato errore
			avvisa "Copia delle foto non riuscita" "Stanotte la copia delle foto nel cloud non è riuscita. Guarda in Controllo servizi o con: mediabox logs foto-cloud. Riprovo domani notte."
		fi
	fi
	sleep 600
done
