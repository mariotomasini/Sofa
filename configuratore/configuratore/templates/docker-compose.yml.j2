# -----------------------------------------------------------------------------
#  FILE GENERATO DA MEDIABOX — non modificarlo a mano.
#  Cambia il file .env e poi esegui "mediabox configura".
# -----------------------------------------------------------------------------
name: mediabox

networks:
  default:
    name: mediabox
    ipam:
      config:
        - subnet: "{{ SUBNET }}"

volumes:
  caddy_data:
  caddy_config:
  jellyfin_config:
  jellyfin_cache:
  qbittorrent_config:
  radarr_config:
  prowlarr_config:
  cerca_dati:
{%- if sonarr %}
  sonarr_config:
{%- endif %}
{%- if dvb %}
  tvheadend_config:
{%- endif %}
{%- if lidarr %}
  lidarr_config:
{%- endif %}
{%- if navidrome %}
  navidrome_dati:
{%- endif %}
{%- if immich %}
  immich_db:
  immich_modelli:
{%- endif %}
{%- if foto_cloud %}
  foto_cloud_cache:
  foto_cloud_stato:
{%- endif %}
{%- if bazarr %}
  bazarr_config:
{%- endif %}
{%- if tgarr %}
  tgarr_db:
  tgarr_meili:
  tgarr_session:
{%- endif %}
{%- if beszel %}
  beszel_data:
  beszel_chiave:
{%- endif %}
{%- if tailscale %}
  tailscale_stato:
{%- endif %}

x-utente: &utente
  PUID: "{{ PUID }}"
  PGID: "{{ PGID }}"
  TZ: "{{ TZ }}"

# Controllo di salute: ogni 30 secondi ogni servizio dice se risponde. Se non risponde
# per 3 volte di fila (un minuto e mezzo) diventa "unhealthy" e il custode lo riavvia.
# start_period: il tempo concesso all'avvio (sui PC lenti i programmi ci mettono minuti).
x-controllo: &controllo
  interval: 30s
  timeout: 15s
  retries: 3
# I servizi con questa etichetta li sorveglia il custode
x-custodito: &custodito
  autoheal: "true"
# Priorità del processore quando il PC è al massimo: quello che usi tu (Cerca, Jellyfin,
# pagina iniziale) passa davanti ai lavori in sottofondo. Con il PC libero non cambia nulla.
x-sottofondo: &sottofondo 512

services:
  # Unico punto di ingresso: http://{{ NOME_HOST }} (Cerca) e la porta del Pannello
  caddy:
    image: "{{ IMG_CADDY }}"
    restart: unless-stopped
    ports:
      - "{{ HTTP_PORT }}:80"
      - "{{ PANNELLO_PORT | default('8081') }}:8081"
{%- if immich %}
      - "{{ foto_porta }}:2283"
{%- endif %}
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    labels: *custodito
    healthcheck:
      <<: *controllo
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1/.salute"]
      start_period: 30s

  # Pannello: le tessere dei servizi e lo stato del PC (http://{{ NOME_HOST }}:{{ PANNELLO_PORT | default('8081') }})
  homepage:
    image: "{{ IMG_HOMEPAGE }}"
    restart: unless-stopped
    environment:
      <<: *utente
      HOMEPAGE_ALLOWED_HOSTS: "localhost:3000"
      # per i numeri dal vivo dei download (le chiavi restano qui, non nella pagina)
      HOMEPAGE_VAR_UTENTE: "{{ ADMIN_USER }}"
      HOMEPAGE_VAR_PASSWORD: "{{ ADMIN_PASSWORD }}"
      HOMEPAGE_VAR_RADARR: "{{ RADARR_API_KEY }}"
      HOMEPAGE_VAR_SONARR: "{{ SONARR_API_KEY if sonarr else '' }}"
      HOMEPAGE_VAR_LIDARR: "{{ LIDARR_API_KEY if lidarr else '' }}"
    volumes:
      - ./homepage:/app/config
      # solo per mostrare lo spazio libero nel Pannello
      - "{{ MEDIA_DIR }}:/dati-media:ro"
    labels: *custodito

  jellyfin:
    image: "{{ IMG_JELLYFIN }}"
    restart: unless-stopped
    user: "{{ PUID }}:{{ PGID }}"
{%- if vaapi %}
    group_add:
      - "{{ RENDER_GID }}"
    devices:
      - /dev/dri:/dev/dri
{%- endif %}
    environment:
      TZ: "{{ TZ }}"
      JELLYFIN_PublishedServerUrl: "http://{{ HOST_IP or NOME_HOST }}/jellyfin"
    volumes:
      - jellyfin_config:/config
      - jellyfin_cache:/cache
      - "{{ MEDIA_DIR }}/media:/data"
    labels: *custodito
    healthcheck:
      <<: *controllo
      test: ["CMD", "curl", "-fsS", "-m", "10", "-o", "/dev/null", "http://localhost:8096/jellyfin/health"]
      start_period: 600s

  qbittorrent:
    image: "{{ IMG_QBITTORRENT }}"
    restart: unless-stopped
    environment:
      <<: *utente
      WEBUI_PORT: "8080"
      TORRENTING_PORT: "{{ TORRENT_PORT }}"
    ports:
      - "{{ TORRENT_PORT }}:{{ TORRENT_PORT }}"
      - "{{ TORRENT_PORT }}:{{ TORRENT_PORT }}/udp"
    volumes:
      - qbittorrent_config:/config
      - "{{ MEDIA_DIR }}:/data"
    cpu_shares: *sottofondo
    labels: *custodito
    healthcheck:
      <<: *controllo
      test: ["CMD", "curl", "-fsS", "-m", "10", "-o", "/dev/null", "http://localhost:8080/"]
      start_period: 120s

  radarr:
    image: "{{ IMG_RADARR }}"
    restart: unless-stopped
    environment:
      <<: *utente
      RADARR__SERVER__URLBASE: /radarr
      RADARR__AUTH__APIKEY: "{{ RADARR_API_KEY }}"
      RADARR__AUTH__METHOD: External
      RADARR__AUTH__REQUIRED: DisabledForLocalAddresses
      RADARR__LOG__ANALYTICSENABLED: "False"
    volumes:
      - radarr_config:/config
      - "{{ MEDIA_DIR }}:/data"
    cpu_shares: *sottofondo
    labels: *custodito
    healthcheck:
      <<: *controllo
      test: ["CMD", "curl", "-fsS", "-m", "10", "-o", "/dev/null", "http://localhost:7878/radarr/ping"]
      start_period: 300s

  prowlarr:
    image: "{{ IMG_PROWLARR }}"
    restart: unless-stopped
    environment:
      <<: *utente
      PROWLARR__SERVER__URLBASE: /prowlarr
      PROWLARR__AUTH__APIKEY: "{{ PROWLARR_API_KEY }}"
      PROWLARR__AUTH__METHOD: External
      PROWLARR__AUTH__REQUIRED: DisabledForLocalAddresses
      PROWLARR__LOG__ANALYTICSENABLED: "False"
    volumes:
      - prowlarr_config:/config
    cpu_shares: *sottofondo
    labels: *custodito
    healthcheck:
      <<: *controllo
      test: ["CMD", "curl", "-fsS", "-m", "10", "-o", "/dev/null", "http://localhost:9696/prowlarr/ping"]
      start_period: 300s
{%- if sonarr %}

  sonarr:
    image: "{{ IMG_SONARR }}"
    restart: unless-stopped
    environment:
      <<: *utente
      SONARR__SERVER__URLBASE: /sonarr
      SONARR__AUTH__APIKEY: "{{ SONARR_API_KEY }}"
      SONARR__AUTH__METHOD: External
      SONARR__AUTH__REQUIRED: DisabledForLocalAddresses
      SONARR__LOG__ANALYTICSENABLED: "False"
    volumes:
      - sonarr_config:/config
      - "{{ MEDIA_DIR }}:/data"
    cpu_shares: *sottofondo
    labels: *custodito
    healthcheck:
      <<: *controllo
      test: ["CMD", "curl", "-fsS", "-m", "10", "-o", "/dev/null", "http://localhost:8989/sonarr/ping"]
      start_period: 300s
{%- endif %}
{%- if dvb %}

  tvheadend:
    image: "{{ IMG_TVHEADEND }}"
    restart: unless-stopped
    environment:
      <<: *utente
      RUN_OPTS: "--http_root /tv"
    devices:
      - /dev/dvb:/dev/dvb
    volumes:
      - tvheadend_config:/config
      - "{{ MEDIA_DIR }}/media/registrazioni/tvheadend:/recordings"
{%- endif %}
{%- if lidarr %}

  # Musica: cerca, scarica e ordina per artista e album
  lidarr:
    image: "{{ IMG_LIDARR }}"
    restart: unless-stopped
    environment:
      <<: *utente
      LIDARR__SERVER__URLBASE: /lidarr
      LIDARR__AUTH__APIKEY: "{{ LIDARR_API_KEY }}"
      LIDARR__AUTH__METHOD: External
      LIDARR__AUTH__REQUIRED: DisabledForLocalAddresses
      LIDARR__LOG__ANALYTICSENABLED: "False"
    volumes:
      - lidarr_config:/config
      - "{{ MEDIA_DIR }}:/data"
    cpu_shares: *sottofondo
    labels: *custodito
    healthcheck:
      <<: *controllo
      test: ["CMD", "curl", "-fsS", "-m", "10", "-o", "/dev/null", "http://localhost:8686/lidarr/ping"]
      start_period: 300s
{%- endif %}
{%- if navidrome %}

  # Musica nelle app per telefono e computer (API Subsonic: Amperfy, Symfonium, Feishin…).
  # Legge la stessa cartella di Jellyfin; l'accesso lo chiede lui (utente e password di mediabox).
  navidrome:
    image: "{{ IMG_NAVIDROME }}"
    restart: unless-stopped
    user: "{{ PUID }}:{{ PGID }}"
    environment:
      TZ: "{{ TZ }}"
      ND_BASEURL: /navidrome
      ND_DEFAULTLANGUAGE: "{{ LINGUA | default('it') }}"
      # se la cartella non avvisa dei file nuovi (es. dischi di Windows), ricontrolla ogni ora
      ND_SCANNER_SCHEDULE: "@every 1h"
      ND_ENABLEINSIGHTSCOLLECTOR: "false"
      ND_LOGLEVEL: warn
    volumes:
      - navidrome_dati:/data
      - "{{ MEDIA_DIR }}/media/musica:/music:ro"
    labels: *custodito
    healthcheck:
      <<: *controllo
      test: ["CMD", "wget", "-q", "-O", "/dev/null", "http://127.0.0.1:4533/ping"]
      start_period: 120s
{%- endif %}
{%- if immich %}

  # Foto: i telefoni di casa caricano da soli foto e video (app Immich), i volti si
  # riconoscono qui sul PC. Ogni persona ha il suo account e vede solo le sue foto.
  # Le foto stanno in MEDIA_DIR/foto/library/<persona>/<anno>/...; ogni notte Immich salva
  # anche una copia del suo database in MEDIA_DIR/foto/backups.
  immich-server:
    image: "{{ IMG_IMMICH }}"
    restart: unless-stopped
    environment:
      TZ: "{{ TZ }}"
      DB_HOSTNAME: immich-db
      DB_USERNAME: postgres
      DB_PASSWORD: "{{ IMMICH_DB_PASSWORD }}"
      DB_DATABASE_NAME: immich
      REDIS_HOSTNAME: immich-redis
      IMMICH_LOG_LEVEL: warn
    volumes:
      - "{{ MEDIA_DIR }}/foto:/data"
    depends_on:
      immich-db:
        condition: service_healthy
      immich-redis:
        condition: service_started
    labels: *custodito
    healthcheck:
      <<: *controllo
      test: ["CMD", "immich-healthcheck"]
      start_period: 300s

  # Riconoscimento dei volti e ricerca per contenuto ("spiaggia", "torta"): tutto sul PC,
  # nessuna foto esce di casa. Lavora in sottofondo e libera la memoria quando ha finito.
  immich-machine-learning:
    image: "{{ IMG_IMMICH_ML }}"
    restart: unless-stopped
    environment:
      TZ: "{{ TZ }}"
      MACHINE_LEARNING_MODEL_REVISION: v2
      IMMICH_LOG_LEVEL: warn
    volumes:
      - immich_modelli:/cache
    cpu_shares: *sottofondo
    labels: *custodito
    healthcheck:
      <<: *controllo
      test: ["CMD", "python3", "healthcheck.py"]
      start_period: 300s

  immich-redis:
    image: "{{ IMG_IMMICH_REDIS }}"
    restart: unless-stopped
    healthcheck:
      <<: *controllo
      test: ["CMD-SHELL", "redis-cli ping | grep -q PONG"]

  immich-db:
    image: "{{ IMG_IMMICH_DB }}"
    restart: unless-stopped
    environment:
      POSTGRES_USER: postgres
      POSTGRES_DB: immich
      POSTGRES_PASSWORD: "{{ IMMICH_DB_PASSWORD }}"
      POSTGRES_INITDB_ARGS: "--data-checksums"
    # nel volume di Docker, non nella cartella dei media: il database non funziona
    # bene sui dischi di rete o di Windows
    volumes:
      - immich_db:/var/lib/postgresql/data
    shm_size: 128mb
    healthcheck:
      <<: *controllo
      test: ["CMD-SHELL", "pg_isready -U postgres -d immich"]
      start_period: 120s
{%- endif %}
{%- if foto_cloud %}

  # Copia delle foto fuori casa, nel cloud: cifrata qui sul PC (restic) prima di partire.
  # Ogni notte solo le foto nuove; tiene le versioni passate fino a 24 mesi.
  foto-cloud:
    image: "{{ IMG_RESTIC }}"
    restart: unless-stopped
    entrypoint: ["/bin/sh", "/copia.sh"]
    environment:
      TZ: "{{ TZ }}"
      RESTIC_REPOSITORY: "{{ FOTO_CLOUD_REPO }}"
      RESTIC_PASSWORD: "{{ FOTO_CLOUD_PASSWORD }}"
      AWS_ACCESS_KEY_ID: "{{ FOTO_CLOUD_ID }}"
      AWS_SECRET_ACCESS_KEY: "{{ FOTO_CLOUD_CHIAVE }}"
      LIMITE_KB: "{{ FOTO_CLOUD_LIMITE_KB | default('') }}"
      NTFY_TOPIC: "{{ NTFY_TOPIC }}"
      NTFY_SERVER: "{{ NTFY_SERVER }}"
      # restic gira con priorità bassa: chi guarda un film non se ne accorge
      NICE: "10"
    volumes:
      - ./foto-cloud.sh:/copia.sh:ro
      - "{{ MEDIA_DIR }}/foto:/foto:ro"
      - foto_cloud_cache:/root/.cache/restic
      - foto_cloud_stato:/stato
      # per i ripristini: le foto tornano qui, mai sopra quelle che ci sono
      - "{{ MEDIA_DIR }}/foto-ripristinate:/ripristino"
    cpu_shares: 256
{%- endif %}
{%- if bazarr %}

  # Sottotitoli automatici per film{% if sonarr %} e serie{% endif %}
  bazarr:
    image: "{{ IMG_BAZARR }}"
    restart: unless-stopped
    environment:
      <<: *utente
    volumes:
      - bazarr_config:/config
      - "{{ MEDIA_DIR }}:/data"
    cpu_shares: *sottofondo
    labels: *custodito
    healthcheck:
      <<: *controllo
      test: ["CMD", "curl", "-fsS", "-m", "10", "-o", "/dev/null", "http://localhost:6767/bazarr/"]
      start_period: 300s
{%- endif %}
{%- if tgarr %}

  # Telegram come fonte: tgarr indicizza i canali e i gruppi del tuo account Telegram
  # e si presenta a Radarr/Sonarr come indexer Newznab + client SABnzbd.
  tgarr-db:
    image: "{{ IMG_TGARR_DB }}"
    restart: unless-stopped
    environment:
      POSTGRES_USER: tgarr
      POSTGRES_DB: tgarr
      POSTGRES_PASSWORD: "{{ TGARR_DB_PASSWORD }}"
    volumes:
      - tgarr_db:/var/lib/postgresql/data
    cpu_shares: *sottofondo
    healthcheck:
      <<: *controllo
      test: ["CMD-SHELL", "pg_isready -U tgarr -d tgarr"]
      start_period: 60s

  tgarr-meili:
    image: "{{ IMG_TGARR_MEILI }}"
    restart: unless-stopped
    environment:
      MEILI_MASTER_KEY: "{{ TGARR_MEILI_KEY }}"
      MEILI_ENV: production
      MEILI_NO_ANALYTICS: "true"
    volumes:
      - tgarr_meili:/meili_data
    cpu_shares: *sottofondo

  tgarr-crawler:
    image: "{{ IMG_TGARR_CRAWLER }}"
    restart: unless-stopped
    depends_on:
      tgarr-db:
        condition: service_healthy
      tgarr-meili:
        condition: service_started
    environment:
      TZ: "{{ TZ }}"
      TG_API_ID: "{{ TG_API_ID }}"
      TG_API_HASH: "{{ TG_API_HASH }}"
      TG_PHONE: "{{ TG_PHONE }}"
      DB_DSN: "postgresql://tgarr:{{ TGARR_DB_PASSWORD }}@tgarr-db:5432/tgarr"
      MEILI_URL: http://tgarr-meili:7700
      MEILI_MASTER_KEY: "{{ TGARR_MEILI_KEY }}"
      TG_DOWNLOAD_ROOT: /downloads/tgarr
    volumes:
      - tgarr_session:/app/session
      - "{{ MEDIA_DIR }}/downloads:/downloads"
    cpu_shares: *sottofondo

  tgarr:
    image: "{{ IMG_TGARR_API }}"
    restart: unless-stopped
    init: true
    depends_on:
      tgarr-db:
        condition: service_healthy
    environment:
      TZ: "{{ TZ }}"
      DB_DSN: "postgresql://tgarr:{{ TGARR_DB_PASSWORD }}@tgarr-db:5432/tgarr"
      TG_API_ID: "{{ TG_API_ID }}"
      TG_API_HASH: "{{ TG_API_HASH }}"
      MEILI_URL: http://tgarr-meili:7700
      MEILI_MASTER_KEY: "{{ TGARR_MEILI_KEY }}"
      TMDB_API_KEY: "{{ TMDB_API_KEY }}"
      TGARR_API_KEY: "{{ TGARR_API_KEY }}"
      TGARR_UI_PASSWORD: "{{ ADMIN_PASSWORD }}"
      TGARR_UPDATE_CHECK: "false"
    volumes:
      - tgarr_session:/app/session
      - "{{ MEDIA_DIR }}/downloads:/downloads"
    ports:
      - "{{ TGARR_PORT }}:8088"
    cpu_shares: *sottofondo
{%- endif %}
{%- if flaresolverr %}

  # Aiuta Prowlarr con gli indexer protetti da Cloudflare (nessuna interfaccia)
  flaresolverr:
    image: "{{ IMG_FLARESOLVERR }}"
    restart: unless-stopped
    environment:
      TZ: "{{ TZ }}"
      LOG_LEVEL: info
    cpu_shares: 256
    labels: *custodito
    healthcheck:
      <<: *controllo
      test: ["CMD", "curl", "-fsS", "-m", "10", "-o", "/dev/null", "http://localhost:8191/health"]
      start_period: 120s
{%- endif %}
{%- if beszel %}

  # Monitoraggio: grafici e avvisi per processore, memoria, dischi e temperatura
  beszel:
    image: "{{ IMG_BESZEL }}"
    restart: unless-stopped
    environment:
      APP_URL: "http://{{ NOME_HOST }}/beszel"
      # Beszel ha il suo accesso: email {{ ADMIN_USER }}@mediabox.local e la password di mediabox
      # (non può stare dietro la password di Caddy: usano la stessa intestazione del browser)
      DISABLE_PASSWORD_AUTH: "false"
    volumes:
      - beszel_data:/beszel_data

  beszel-agent:
    image: "{{ IMG_BESZEL_AGENT }}"
    restart: unless-stopped
{%- if PIATTAFORMA == "windows" %}
    # Docker Desktop: l'agente vede la macchina virtuale di Docker, non tutto Windows
{%- else %}
    # Rete dell'host: così misura la rete e i dischi veri del PC
    network_mode: host
{%- endif %}
    environment:
      LISTEN: "45876"
      KEY_FILE: /chiave/beszel.pub
      EXTRA_FILESYSTEMS: /extra-filesystems/media
    volumes:
      - beszel_chiave:/chiave:ro
      - "{{ MEDIA_DIR }}:/extra-filesystems/media:ro"
{%- endif %}

  # Ricerca unificata dei film (TMDB + Internet Archive + Prowlarr)
  cerca:
    build:
      context: ../cerca
      args:
        BASE_IMAGE: "{{ IMG_PYTHON }}"
    image: mediabox/cerca:locale
    restart: unless-stopped
    user: "{{ PUID }}:{{ PGID }}"
    environment:
      TZ: "{{ TZ }}"
      TMDB_API_KEY: "{{ TMDB_API_KEY }}"
      PAESE: "{{ PAESE }}"
      LINGUA: "{{ LINGUA }}"
      NTFY_TOPIC: "{{ NTFY_TOPIC }}"
      NTFY_SERVER: "{{ NTFY_SERVER }}"
      PROWLARR_URL: http://prowlarr:9696/prowlarr
      PROWLARR_API_KEY: "{{ PROWLARR_API_KEY }}"
      RADARR_URL: http://radarr:7878/radarr
      RADARR_API_KEY: "{{ RADARR_API_KEY }}"
      QBIT_URL: http://qbittorrent:8080
      JELLYFIN_URL: http://jellyfin:8096/jellyfin
      ADMIN_USER: "{{ ADMIN_USER }}"
      ADMIN_PASSWORD: "{{ ADMIN_PASSWORD }}"
      INDIRIZZO_PUBBLICO: "http://{{ NOME_HOST }}{{ porta_principale }}"
      PANNELLO_PORT: "{{ PANNELLO_PORT | default('8081') }}"
      SOGLIA_DISCO_LIBERO: "{{ SOGLIA_DISCO_LIBERO }}"
      PULIZIA_VISTI: "{{ PULIZIA_VISTI }}"
      PULIZIA_GIORNI: "{{ PULIZIA_GIORNI }}"
      LINGUE_AUDIO: "{{ LINGUE_AUDIO }}"
      MIN_FONTI: "{{ MIN_FONTI | default('3') }}"
      SONARR_URL: "{{ 'http://sonarr:8989/sonarr' if sonarr else '' }}"
      SONARR_API_KEY: "{{ SONARR_API_KEY if sonarr else '' }}"
      ANIMEUNITY_URL: "{{ ANIMEUNITY_URL | default('https://animeunity.cx') }}"
      ANIMEWORLD_URL: "{{ ANIMEWORLD_URL | default('https://www.animeworld.ac') }}"
      STREAMINGCOMMUNITY_URL: "{{ STREAMINGCOMMUNITY_URL | default('') }}"
      LIDARR_URL: "{{ 'http://lidarr:8686/lidarr' if lidarr else '' }}"
      LIDARR_API_KEY: "{{ LIDARR_API_KEY if lidarr else '' }}"
      NAVIDROME_URL: "{{ 'http://navidrome:4533' if navidrome else '' }}"
      IMMICH_URL: "{{ 'http://immich-server:2283' if immich else '' }}"
      FOTO_COPIA: "{{ 'si' if foto_copia else 'no' }}"
      FOTO_CLOUD: "{{ 'si' if foto_cloud else 'no' }}"
    volumes:
      - cerca_dati:/dati
      - "{{ MEDIA_DIR }}:/data"
{%- if foto_cloud %}
      # solo per mostrare in Controllo servizi com'è andata l'ultima copia nel cloud
      - foto_cloud_stato:/foto-cloud:ro
{%- endif %}
{%- if foto_copia %}
      # copia di sicurezza notturna delle foto, su un altro disco
      - "{{ foto_copia }}:/copia-foto"
{%- endif %}
    labels: *custodito
    healthcheck:
      # sui PC lenti anche solo avviare python per il controllo richiede qualche secondo
      <<: *controllo
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/salute', timeout=10)"]
      start_period: 120s

  # Strumento interno: configura i servizi, backup e ripristino.
  # Non resta acceso: si avvia solo con "docker compose run".
  # Configurazione dal browser (/impostazioni). È lo stesso programma del configuratore.
  impostazioni:
    image: mediabox/configuratore:locale
    pull_policy: never
    restart: unless-stopped
    user: "{{ PUID }}:{{ PGID }}"
    command: ["web"]
    environment:
      TZ: "{{ TZ }}"
    volumes:
      - ..:/mediabox
{%- if tailscale_socket %}
      # per mostrare nella pagina lo stato di Tailscale e il link per accedere
      - /var/run/tailscale:/var/run/tailscale
{%- endif %}
    labels: *custodito
    healthcheck:
      <<: *controllo
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8080/impostazioni/salute', timeout=10)"]
      start_period: 120s

{%- if tailscale %}
  # Tailscale: mediabox anche fuori casa, senza aprire porte sul router. Si installa e si
  # aggiorna con mediabox; l'accesso (una volta sola, con il tuo account) si fa dalla pagina
  # delle impostazioni, che mostra il link. Rete dell'host: l'indirizzo 100.x è del PC.
  tailscale:
    image: "{{ IMG_TAILSCALE | default('ghcr.io/tailscale/tailscale:v1.104.4') }}"
    restart: unless-stopped
    network_mode: host
    init: true
    cap_add: [NET_ADMIN, NET_RAW]
    devices:
      - /dev/net/tun:/dev/net/tun
    # tailscaled avviato direttamente: l'avvio standard dell'immagine (containerboot) aspetta
    # l'accesso solo 60 secondi, poi si spegne e riparte con un link nuovo, e quello aperto nel
    # browser non vale più. Così il link resta valido finché non accedi. "tailscale up" riprova
    # finché tailscaled non risponde; con l'accesso già fatto torna subito.
    entrypoint: ["/bin/sh", "-c"]
    command:
      - |
        (until tailscale --socket=/var/run/tailscale/tailscaled.sock up --reset --timeout=0 \
            --hostname=mediabox --accept-dns=false; do sleep 5; done) &
        exec tailscaled --statedir=/var/lib/tailscale --socket=/var/run/tailscale/tailscaled.sock
    volumes:
      - tailscale_stato:/var/lib/tailscale
      - /var/run/tailscale:/var/run/tailscale
    cpu_shares: 256

{% endif %}
  # Custode: se un servizio smette di rispondere (controllo di salute "unhealthy") lo
  # riavvia in pochi secondi. È minuscolo (un piccolo programma, pochi MB di memoria).
  custode:
    image: "{{ IMG_AUTOHEAL }}"
    restart: unless-stopped
    environment:
      AUTOHEAL_CONTAINER_LABEL: autoheal
      AUTOHEAL_INTERVAL: "15"
      AUTOHEAL_DEFAULT_STOP_TIMEOUT: "10"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    cpu_shares: 256

  configuratore:
    build:
      context: ../configuratore
      args:
        BASE_IMAGE: "{{ IMG_PYTHON }}"
    image: mediabox/configuratore:locale
    profiles: ["strumenti"]
    volumes:
      - ..:/mediabox
      - "{{ MEDIA_DIR }}:/data"
      - jellyfin_config:/volumi/jellyfin_config
      - qbittorrent_config:/volumi/qbittorrent_config
      - radarr_config:/volumi/radarr_config
      - prowlarr_config:/volumi/prowlarr_config
      - cerca_dati:/volumi/cerca_dati
      - caddy_data:/volumi/caddy_data
{%- if sonarr %}
      - sonarr_config:/volumi/sonarr_config
{%- endif %}
{%- if dvb %}
      - tvheadend_config:/volumi/tvheadend_config
{%- endif %}
{%- if lidarr %}
      - lidarr_config:/volumi/lidarr_config
{%- endif %}
{%- if navidrome %}
      - navidrome_dati:/volumi/navidrome_dati
{%- endif %}
{%- if bazarr %}
      - bazarr_config:/volumi/bazarr_config
{%- endif %}
{%- if beszel %}
      - beszel_data:/volumi/beszel_data
      - beszel_chiave:/volumi/beszel_chiave
{%- endif %}
