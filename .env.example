# =============================================================================
#  mediabox — file di configurazione
#  Tutto mediabox si configura da qui. L'installer compila questo file da solo:
#  modificalo solo se sai cosa stai cambiando, poi esegui "mediabox configura".
# =============================================================================

# ---- Le uniche tre cose che l'installer chiede --------------------------------
# Chiave API di TMDB (themoviedb.org → Impostazioni → API). Va bene sia la
# "API Key" corta sia il "Read Access Token" lungo.
TMDB_API_KEY=
# Password unica di amministrazione (Jellyfin, pannelli, qBittorrent).
ADMIN_PASSWORD=
# Argomento ntfy per le notifiche sul telefono (facoltativo, es. mediabox-casa-rossi).
NTFY_TOPIC=

# ---- Generati automaticamente: non serve toccarli -----------------------------
ADMIN_USER=admin
RADARR_API_KEY=
PROWLARR_API_KEY=
SONARR_API_KEY=

# ---- Sistema ---------------------------------------------------------------
# linux oppure windows (lo imposta l'installer)
PIATTAFORMA=linux
TZ=Europe/Rome
PAESE=IT
LINGUA=it
# Utente e gruppo che possiedono i file (su Windows restano 1000).
PUID=1000
PGID=1000
# Cartella con film, serie, registrazioni e download.
# Linux: /srv/mediabox/dati   —   Windows: D:/Mediabox (usa le barre "/")
MEDIA_DIR=/srv/mediabox/dati
# Porta del sito di mediabox (80 = basta scrivere http://mediabox.local)
HTTP_PORT=80
# Porta usata da qBittorrent (non va aperta sul router)
TORRENT_PORT=6881
# Indirizzo del PC nella rete di casa (lo rileva l'installer)
HOST_IP=
NOME_HOST=mediabox.local
# Rete interna dei container. Cambiala solo se coincide con quella di casa.
SUBNET=172.28.64.0/24

# ---- Hardware (rilevato dall'installer) ------------------------------------
# Transcodifica con la scheda grafica Intel (solo Linux)
VAAPI=no
# Gruppo proprietario di /dev/dri/renderD128 (solo Linux)
RENDER_GID=
# Tuner USB su /dev/dvb → TVHeadend (solo Linux)
DVB=no
# Indirizzo di un HDHomeRun in rete (vuoto = nessuno)
HDHOMERUN_IP=
# Guida TV XMLTV per l'HDHomeRun (facoltativa, vedi README)
EPG_XMLTV_URL=

# ---- Servizi facoltativi ---------------------------------------------------
WITH_SONARR=no

# ---- Varie -----------------------------------------------------------------
NTFY_SERVER=https://ntfy.sh
INTRO_SKIPPER_REPO=https://intro-skipper.org/manifest.json

# ---- Versioni delle immagini (aggiornate con "mediabox update") -------------
IMG_CADDY=docker.io/library/caddy:2.11.9
IMG_HOMEPAGE=ghcr.io/gethomepage/homepage:v2.8.0
IMG_JELLYFIN=ghcr.io/jellyfin/jellyfin:12.4
IMG_QBITTORRENT=lscr.io/linuxserver/qbittorrent:5.3.0
IMG_RADARR=lscr.io/linuxserver/radarr:7.0.3
IMG_PROWLARR=lscr.io/linuxserver/prowlarr:3.0.2
IMG_SONARR=lscr.io/linuxserver/sonarr:4.0.20
IMG_TVHEADEND=lscr.io/linuxserver/tvheadend:latest
# Immagine base per Cerca e configuratore
IMG_PYTHON=docker.io/library/python:3.13-slim
