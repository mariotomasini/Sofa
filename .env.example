# =============================================================================
#  mediabox — file di configurazione
#  Tutto mediabox si configura da qui. L'installer compila questo file da solo:
#  modificalo solo se sai cosa stai cambiando, poi esegui "mediabox configura".
# =============================================================================

# ---- Le compila la configurazione nel browser (http://mediabox.local) ---------
# Chiave API di TMDB (facoltativa). Vuota = Cerca usa fonti senza chiavi
# (Radarr, Wikidata, TVmaze). Con la chiave in più: dove vedere i film in Italia
# e l'avviso quando diventano gratis. themoviedb.org → Impostazioni → API.
TMDB_API_KEY=
# Password unica di amministrazione (Jellyfin, pannelli, qBittorrent).
ADMIN_PASSWORD=
# Argomento ntfy per le notifiche sul telefono (facoltativo, es. mediabox-casa-rossi).
NTFY_TOPIC=

# ---- Generati automaticamente: non serve toccarli -----------------------------
ADMIN_USER=admin
RADARR_API_KEY=
PROWLARR_API_KEY=
SONARR_API_KEY=
LIDARR_API_KEY=
# Firma del cookie delle impostazioni nel browser
IMPOSTAZIONI_SEGRETO=

# ---- Sistema ---------------------------------------------------------------
# linux oppure windows (lo imposta l'installer)
PIATTAFORMA=linux
TZ=Europe/Rome
PAESE=IT
LINGUA=it
# Utente e gruppo che possiedono i file (su Windows restano 1000).
PUID=1000
PGID=1000
# Cartella con film, serie, registrazioni e download.
# Linux: /srv/mediabox/dati   —   Windows: D:/Mediabox (usa le barre "/")
MEDIA_DIR=/srv/mediabox/dati
# Porta del sito di mediabox (80 = basta scrivere http://mediabox.local)
HTTP_PORT=80
# Porta usata da qBittorrent (non va aperta sul router)
TORRENT_PORT=6881
# Indirizzo del PC nella rete di casa (lo rileva l'installer)
HOST_IP=
NOME_HOST=mediabox.local
# Rete interna dei container. Cambiala solo se coincide con quella di casa.
SUBNET=172.28.64.0/24

# ---- Hardware (rilevato dall'installer) ------------------------------------
# Transcodifica con la scheda grafica Intel (solo Linux)
VAAPI=no
# Gruppo proprietario di /dev/dri/renderD128 (solo Linux)
RENDER_GID=
# Tuner USB su /dev/dvb → TVHeadend (solo Linux)
DVB=no
# Memoria del PC in GB (la rileva l'installer). Sotto i 6 GB la prima volta
# vengono spenti i programmi più pesanti; MODALITA_LEGGERA=si vuol dire che è
# già stato fatto (con "no" non si spegne niente).
MEMORIA_GB=
MODALITA_LEGGERA=
# Indirizzo di un HDHomeRun in rete (vuoto = nessuno)
HDHOMERUN_IP=
# Guida TV XMLTV per l'HDHomeRun (facoltativa, vedi README)
EPG_XMLTV_URL=

# ---- Cosa guardi e ascolti (si cambia con "mediabox impostazioni") ----------
# Serie TV: Sonarr le cerca, scarica e ordina per stagioni
WITH_SONARR=no
# Anime: libreria "Anime" separata in Jellyfin, gestita da Sonarr
WITH_ANIME=no
# Musica: libreria "Musica" in Jellyfin (sempre) + Lidarr per scaricarla e ordinarla
WITH_LIDARR=no
# Sottotitoli automatici con Bazarr
WITH_BAZARR=si
# Lingue dei sottotitoli, in ordine di preferenza (codici a 2 lettere)
LINGUE_SOTTOTITOLI=it,en
# FlareSolverr: aiuta gli indexer protetti da Cloudflare (usa circa 300 MB di memoria)
WITH_FLARESOLVERR=si
# Beszel: grafici di processore, memoria, dischi e temperatura, con avvisi sul telefono
WITH_BESZEL=no
# Avviso quando lo spazio libero del disco dei media scende sotto questa percentuale
SOGLIA_DISCO_LIBERO=10
# Pulizia automatica quando il disco è quasi pieno: i download abbandonati si tolgono sempre;
# con PULIZIA_VISTI=si anche film ed episodi visti da più di PULIZIA_GIORNI giorni (mai i preferiti)
PULIZIA_VISTI=no
PULIZIA_GIORNI=30
# Aggiornamento automatico di mediabox quando esce una nuova versione su GitHub
AGGIORNAMENTI_AUTOMATICI=si
MEDIABOX_REPO=mariotomasini/Sofa

# ---- Varie -----------------------------------------------------------------
NTFY_SERVER=https://ntfy.sh
INTRO_SKIPPER_REPO=https://intro-skipper.org/manifest.json

# ---- Versioni delle immagini (aggiornate con "mediabox update") -------------
IMG_CADDY=docker.io/library/caddy:2.11.9
IMG_HOMEPAGE=ghcr.io/gethomepage/homepage:v2.8.0
IMG_JELLYFIN=ghcr.io/jellyfin/jellyfin:12.4
IMG_QBITTORRENT=lscr.io/linuxserver/qbittorrent:5.3.0
IMG_RADARR=lscr.io/linuxserver/radarr:7.0.3
IMG_AUTOHEAL=docker.io/willfarrell/autoheal:1.2.0
IMG_PROWLARR=lscr.io/linuxserver/prowlarr:3.0.2
IMG_SONARR=lscr.io/linuxserver/sonarr:4.0.20
IMG_TVHEADEND=lscr.io/linuxserver/tvheadend:latest
IMG_LIDARR=lscr.io/linuxserver/lidarr:3.1.6
IMG_BAZARR=lscr.io/linuxserver/bazarr:1.6.2
IMG_FLARESOLVERR=ghcr.io/flaresolverr/flaresolverr:v3.5.2
IMG_BESZEL=ghcr.io/henrygd/beszel/beszel:0.21.2
IMG_BESZEL_AGENT=ghcr.io/henrygd/beszel/beszel-agent:0.21.2
# Immagine base per Cerca e configuratore
IMG_PYTHON=docker.io/library/python:3.13-slim
