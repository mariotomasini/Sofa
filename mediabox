#!/usr/bin/env bash
# =============================================================================
#  mediabox — comando per gestire il media server (Linux)
#  Scrivi "mediabox aiuto" per l'elenco dei comandi.
# =============================================================================
set -euo pipefail

# Segue il collegamento /usr/local/bin/mediabox fino alla cartella vera
MEDIABOX_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
ENV_FILE="$MEDIABOX_DIR/.env"
# shellcheck source=lib/comune.sh
source "$MEDIABOX_DIR/lib/comune.sh"
# shellcheck source=lib/docker.sh
source "$MEDIABOX_DIR/lib/docker.sh"
# shellcheck source=lib/aggiorna.sh
source "$MEDIABOX_DIR/lib/aggiorna.sh"

aiuto() {
  cat <<'EOF'
Uso: mediabox <comando>

  up                 accende tutti i servizi
  down               spegne tutti i servizi
  restart [servizio] riavvia tutto (o un solo servizio, es. "mediabox restart jellyfin")
  status             mostra quali servizi sono accesi
  logs [servizio]    mostra i messaggi dei servizi (Ctrl+C per uscire)
  impostazioni       cambia cosa usi dal terminale (più comodo dal browser: /impostazioni)
  azzera-jellyfin    rifà Jellyfin da zero con l'utente di mediabox (i film restano)
  configura          rigenera la configurazione dal file .env e la riapplica
  update             aggiorna mediabox e i servizi all'ultima versione (fa prima un backup)
  versione           mostra la versione installata e l'ultima disponibile
  backup             salva configurazioni e impostazioni nella cartella backup/
  restore <file>     ripristina un backup
  remote             installa Tailscale per usare mediabox da fuori casa
  indirizzi          mostra gli indirizzi da aprire nel browser
  foto-cloud collega collega lo Storage Box di Hetzner alla copia delle foto (una volta sola)
  foto-cloud stato   le copie delle foto nel cloud, una per notte
  foto-cloud ripristina  riporta le foto dal cloud nella cartella foto-ripristinate
EOF
}

controlla_installazione() {
  [[ -f "$ENV_FILE" ]] || errore "mediabox non è ancora installato." "Lancia ./install.sh dalla cartella di mediabox."
  [[ -f "$MEDIABOX_DIR/generato/docker-compose.yml" ]] || configuratore_genera
}

stato() {
  titolo "Stato dei servizi"
  compose ps --all --format '{{.Service}}\t{{.State}}\t{{.Health}}' | sort | while IFS=$'\t' read -r servizio st salute; do
    case "$st" in
      running) testo="${C_OK}acceso${C_FINE}" ;;
      restarting) testo="${C_AVVISO}si sta riavviando (controlla: mediabox logs $servizio)${C_FINE}" ;;
      exited|dead) testo="${C_ERRORE}spento${C_FINE}" ;;
      *) testo="$st" ;;
    esac
    case "$salute" in
      unhealthy) testo="$testo ${C_AVVISO}(non risponde bene)${C_FINE}" ;;
      starting) testo="$testo (in avvio)" ;;
    esac
    printf '  %-14s %s\n' "$servizio" "$testo"
  done
}

# Tailscale installato a mano sul PC (versioni vecchie di "mediabox remote") o come servizio di mediabox
tailscale_sul_pc() {
  command -v tailscale >/dev/null 2>&1 && systemctl is-enabled tailscaled >/dev/null 2>&1
}

tailscale_cmd() {
  if tailscale_sul_pc; then tailscale "$@"; else compose exec -T tailscale tailscale "$@"; fi
}

# Vero se Tailscale è collegato e in linea (senza python3 non si controlla: si dà per buono)
tailscale_in_linea() {
  command -v python3 >/dev/null 2>&1 || return 0
  tailscale_cmd status --json 2>/dev/null | python3 -c '
import json, sys
d = json.load(sys.stdin)
sys.exit(0 if d.get("BackendState") == "Running" and (d.get("Self") or {}).get("Online") else 1)' 2>/dev/null
}

aggiorna_ip() {
  local ip
  ip="$(ip_locale)"
  [[ -n "$ip" ]] && scrivi_env HOST_IP "$ip" "$ENV_FILE"
  # se Tailscale c'è già sul PC, mediabox non avvia il suo (due insieme si darebbero fastidio)
  if tailscale_sul_pc; then scrivi_env TAILSCALE_HOST si "$ENV_FILE"; else scrivi_env TAILSCALE_HOST no "$ENV_FILE"; fi
  ip="$(tailscale_cmd ip -4 2>/dev/null | head -n1 || true)"
  [[ "$ip" == 100.* ]] && scrivi_env TAILSCALE_IP "$ip" "$ENV_FILE"
  return 0
}

backup() {
  titolo "Backup"
  info "Spengo i servizi per un minuto, così il backup è completo…"
  compose stop >/dev/null
  if compose run --rm -T configuratore backup; then
    esito=0
  else
    esito=1
  fi
  compose start >/dev/null
  ok "Servizi riaccesi"
  return "$esito"
}

# Copia delle impostazioni (.env) sul disco dei media, in mediabox-impostazioni/: se il PC
# si rompe, per ripartire su un PC nuovo basta il disco ("mediabox restore" di quel file).
# Contiene le password (anche quella della copia delle foto nel cloud): la legge solo il
# proprietario. Si rifà solo se le impostazioni sono cambiate.
copia_impostazioni_sul_disco() {
  local media cartella
  media="$(leggi_env MEDIA_DIR "$ENV_FILE")"
  [[ -n "$media" && -d "$media" ]] || return 0
  cartella="$media/mediabox-impostazioni"
  mkdir -p "$cartella" 2>/dev/null || return 0
  chmod 700 "$cartella" 2>/dev/null || true
  if ! cmp -s "$ENV_FILE" "$cartella/impostazioni.env"; then
    (umask 077 && cp "$ENV_FILE" "$cartella/impostazioni.env.nuovo" \
      && mv -f "$cartella/impostazioni.env.nuovo" "$cartella/impostazioni.env") 2>/dev/null || return 0
  fi
  [[ -f "$cartella/LEGGIMI.txt" ]] || cat > "$cartella/LEGGIMI.txt" 2>/dev/null <<'TESTO' || true
Impostazioni di mediabox (con le password), copiate qui da sole quando cambiano.

PC nuovo con questo disco: installa mediabox, poi scrivi
    mediabox restore <questa cartella>/impostazioni.env
e, se usi le foto, apri la pagina delle foto e scegli "Ripristina da Backup".

Non dare questo file a nessuno: contiene le password di mediabox.
TESTO
  return 0
}

ripristina_impostazioni() {
  local file="$1" cartella_media
  chiedi_si_no "Uso le impostazioni di $file al posto di quelle attuali (film e foto non si toccano). Continuo?" n || exit 0
  compose stop >/dev/null 2>&1 || true
  cp "$ENV_FILE" "$ENV_FILE.prima-del-ripristino" 2>/dev/null || true
  cp "$file" "$ENV_FILE"
  chmod 600 "$ENV_FILE"
  # il file sta in <cartella dei media>/mediabox-impostazioni: la cartella giusta è quella,
  # anche se sul PC vecchio il disco era montato altrove
  if [[ "$(basename "$(dirname "$file")")" == "mediabox-impostazioni" ]]; then
    cartella_media="$(dirname "$(dirname "$file")")"
    scrivi_env MEDIA_DIR "$cartella_media" "$ENV_FILE"
    info "Cartella dei media: $cartella_media"
  fi
  ok "Impostazioni ripristinate (quelle di prima sono in .env.prima-del-ripristino)"
  aggiorna_ip
  applica
}

restore() {
  local file="${1:-}"
  [[ -n "$file" ]] || errore "Indica il file di backup." "Esempio: mediabox restore backup/mediabox-backup-2025-01-31_2100.tar.gz"
  [[ -f "$file" ]] || errore "Non trovo il file $file." "Controlla il nome con: ls $MEDIABOX_DIR/backup"
  # solo le impostazioni (la copia che sta sul disco dei media)?
  if ! tar -tzf "$file" >/dev/null 2>&1; then
    grep -q '^ADMIN_PASSWORD=' "$file" || errore "Questo file non sembra un backup di mediabox." \
      "Usa un file creato con \"mediabox backup\" o mediabox-impostazioni/impostazioni.env dal disco dei media."
    ripristina_impostazioni "$(readlink -f "$file")"
    return
  fi
  local assoluto nome
  assoluto="$(readlink -f "$file")"
  nome="$(basename "$assoluto")"
  # Il configuratore vede solo la cartella di mediabox: se serve, copiamo lì il file
  if [[ "$assoluto" != "$MEDIABOX_DIR/backup/$nome" ]]; then
    mkdir -p "$MEDIABOX_DIR/backup"
    cp "$assoluto" "$MEDIABOX_DIR/backup/$nome"
  fi
  chiedi_si_no "Il ripristino sostituisce le configurazioni attuali (non i film). Continuo?" n || exit 0
  compose stop >/dev/null
  compose run --rm -T configuratore ripristina "backup/$nome"
  chmod 600 "$ENV_FILE"
  aggiorna_ip
  applica
}

remote() {
  titolo "Accesso da fuori casa con Tailscale"
  # link vuoto all'inizio: con "set -u" una variabile mai assegnata fermerebbe lo script
  local ip="" link="" indirizzo porta
  if ! tailscale_sul_pc; then
    # Tailscale è un servizio di mediabox: si installa e si aggiorna da solo
    aggiorna_ip
    configuratore_genera
    compose up -d tailscale >/dev/null 2>&1 \
      || errore "Non riesco ad avviare Tailscale." "Controlla la connessione a Internet e riprova."
    for _ in $(seq 20); do
      tailscale_cmd ip -4 >/dev/null 2>&1 && break
      link="$(tailscale_cmd status --json 2>/dev/null | grep -o '"AuthURL": *"https://[^"]*"' | grep -o 'https://[^"]*' | head -n1 || true)"
      [[ -n "$link" ]] && break
      sleep 2
    done
    if [[ -n "$link" ]]; then
      echo "  Apri questo link e accedi con il tuo account (o crea un account gratuito):"
      echo "    $link"
      echo "  Lo trovi anche nelle impostazioni: $(indirizzo_principale)/impostazioni/ → Fuori casa"
      for _ in $(seq 150); do tailscale_cmd ip -4 >/dev/null 2>&1 && break; sleep 2; done
    fi
  elif ! tailscale ip -4 >/dev/null 2>&1; then
    echo "  Ora apri il link che compare qui sotto e accedi (o crea un account gratuito)."
    sudo tailscale up
  fi
  ip="$(tailscale_cmd ip -4 2>/dev/null | head -n1 || true)"
  [[ -n "$ip" ]] || errore "Tailscale non è ancora collegato." "Apri il link qui sopra, accedi, poi riprova: mediabox remote"
  # collegato all'account ma non in linea: di solito manca Internet o il PC si era sospeso
  if ! tailscale_in_linea; then
    avviso "Tailscale è avviato ma non risulta in linea: riprovo a collegarlo…"
    if tailscale_sul_pc; then sudo systemctl restart tailscaled; else compose restart tailscale >/dev/null; fi
    sleep 10
    if ! tailscale_in_linea; then
      echo "  Ultimi messaggi di Tailscale:"
      if tailscale_sul_pc; then sudo journalctl -u tailscaled -n 15 --no-pager; else compose logs --tail 15 tailscale; fi
      errore "Tailscale non riesce a collegarsi." "Controlla che il PC sia in Internet; manda questi messaggi a chi ti aiuta."
    fi
  fi
  impedisci_sospensione
  scrivi_env TAILSCALE_IP "$ip" "$ENV_FILE"
  porta="$(leggi_env HTTP_PORT "$ENV_FILE")"
  indirizzo="http://$ip"
  [[ -z "$porta" || "$porta" == 80 ]] || indirizzo="$indirizzo:$porta"
  ok "Tailscale attivo. Indirizzo di mediabox da fuori casa: $indirizzo"
  echo
  echo "  Sul telefono installa l'app Tailscale, accedi con lo stesso account,"
  echo "  poi apri $indirizzo nel browser (o $indirizzo/jellyfin nell'app Jellyfin)."
  echo "  Non serve aprire nessuna porta sul router."
}

# Le impostazioni salvate dal browser (/impostazioni): le applica il servizio di sistema
# Il registro che la pagina delle impostazioni mostra durante l'aggiornamento
registro_aggiornamento() {
  printf '\n== %s ==\n' "$(date '+%d/%m/%Y %H:%M')" >> "$MEDIABOX_DIR/aggiornamenti.log"
}

applica_impostazioni_web() {
  local flag="$MEDIABOX_DIR/.da-applicare" cartella_prima
  # "Aggiorna ora" dalla pagina delle impostazioni
  if [[ -f "$MEDIABOX_DIR/.da-aggiornare" ]]; then
    rm -f "$MEDIABOX_DIR/.da-aggiornare" "$flag"
    registro_aggiornamento
    "$MEDIABOX_DIR/mediabox" update >> "$MEDIABOX_DIR/aggiornamenti.log" 2>&1 || true
    return 0
  fi
  [[ -f "$flag" ]] || return 0
  cartella_prima="$(cat "$flag")"
  rm -f "$flag"
  applica_scelte() {
    sposta_media "$cartella_prima" "$(leggi_env MEDIA_DIR "$ENV_FILE")"
    aggiorna_ip
    applica_necessario
  }
  con_registro applica_scelte
}

comando="${1:-aiuto}"
shift || true
case "$comando" in
  aiuto|help|-h|--help) aiuto ;;
  up)
    controlla_installazione; prepara_docker
    compose up -d --remove-orphans && ok "Servizi accesi" ;;
  down)
    controlla_installazione; prepara_docker
    compose down && ok "Servizi spenti" ;;
  restart)
    controlla_installazione; prepara_docker
    compose restart "$@" && ok "Riavviato" ;;
  status)
    controlla_installazione; prepara_docker; stato ;;
  logs)
    controlla_installazione; prepara_docker
    compose logs -f --tail 200 "$@" ;;
  configura)
    controlla_installazione; prepara_docker; aggiorna_ip; applica
    copia_impostazioni_sul_disco ;;
  azzera-jellyfin)
    controlla_installazione; prepara_docker
    titolo "Rifaccio Jellyfin da zero"
    info "Tolgo utenti e impostazioni di Jellyfin (i film nelle cartelle restano dove sono)…"
    compose rm -sf jellyfin >/dev/null 2>&1 || true
    "${DOCKER[@]}" volume rm mediabox_jellyfin_config >/dev/null 2>&1 || true
    ok "Jellyfin azzerato: ora lo riconfiguro con l'utente di mediabox"
    aggiorna_ip; con_registro applica ;;
  applica-impostazioni)
    controlla_installazione; prepara_docker; applica_impostazioni_web
    copia_impostazioni_sul_disco ;;
  prepara-cartella)
    # avviato da systemd come amministratore prima di applica-impostazioni
    cartella="$(leggi_env MEDIA_DIR "$ENV_FILE")"
    if [[ -n "$cartella" && "$cartella" == /* ]]; then
      mkdir -p "$cartella"
      chown "$(leggi_env PUID "$ENV_FILE"):$(leggi_env PGID "$ENV_FILE")" "$cartella"
    fi ;;
  impostazioni)
    controlla_installazione; prepara_docker; configuratore_costruisci
    info "Le stesse scelte le trovi anche nel browser: $(indirizzo_principale)/impostazioni/"
    cartella_prima="$(leggi_env MEDIA_DIR "$ENV_FILE")"
    esito=0
    # shellcheck disable=SC2119  # nessun argomento: menu normale
    menu_impostazioni || esito=$?
    if [[ "$esito" -eq 0 ]]; then
      sposta_media "$cartella_prima" "$(leggi_env MEDIA_DIR "$ENV_FILE")"
      installa_aggiornamenti_automatici
      aggiorna_ip; applica
    elif [[ "$esito" -ne 3 ]]; then
      exit "$esito"
    fi ;;
  update)
    controlla_installazione; prepara_docker
    aggiorna_mediabox ;;
  aggiorna-servizi)
    # avviato da "update" con il codice nuovo
    controlla_installazione; prepara_docker
    aggiorna_servizi ;;
  aggiorna-automatico)
    # avviato ogni notte dal timer di systemd
    controlla_installazione; prepara_docker
    copia_impostazioni_sul_disco
    [[ "$(leggi_env AGGIORNAMENTI_AUTOMATICI "$ENV_FILE")" == "no" ]] && exit 0
    registro_aggiornamento
    "$MEDIABOX_DIR/mediabox" update >> "$MEDIABOX_DIR/aggiornamenti.log" 2>&1 || true
    case "$(grep -o '"fase": "[a-z_]*"' "$MEDIABOX_DIR/aggiornamento.stato" 2>/dev/null)" in
      *fatto*) notifica_ntfy "mediabox aggiornato alla versione $(versione_installata)." ;;
      *errore*) notifica_ntfy "L'aggiornamento di mediabox non è riuscito: apri le impostazioni (/impostazioni) per vedere perché." ;;
    esac ;;
  versione)
    controlla_installazione; prepara_docker; configuratore_costruisci
    echo "  Versione installata: $(versione_installata)"
    configuratore_aggiornamento controlla | grep -E '"(fonte|id|messaggio|disponibile)"' | sed 's/^ */  /' || true ;;
  backup)
    controlla_installazione; prepara_docker; backup ;;
  restore)
    controlla_installazione; prepara_docker; restore "${1:-}" ;;
  remote)
    controlla_installazione; prepara_docker; remote
    configuratore_genera >/dev/null ;;
  indirizzi)
    controlla_installazione; prepara_docker; aggiorna_ip
    configuratore_costruisci
    "${DOCKER[@]}" run --rm -v "$MEDIABOX_DIR:/mediabox" mediabox/configuratore:locale indirizzi ;;
  foto-cloud)
    controlla_installazione; prepara_docker
    if ! compose config --services 2>/dev/null | grep -qx foto-cloud; then
      errore "La copia delle foto nel cloud è spenta." \
        "Accendi le foto e scrivi FOTO_STORAGEBOX (o FOTO_CLOUD_REPO, FOTO_CLOUD_ID e FOTO_CLOUD_CHIAVE) nel file .env, poi \"mediabox configura\"."
    fi
    case "${1:-stato}" in
      collega|stato|ripristina) compose run --rm foto-cloud "${1:-stato}" ;;
      *) errore "Non conosco \"mediabox foto-cloud ${1}\"." "Usa collega, stato o ripristina." ;;
    esac ;;
  *)
    avviso "Comando sconosciuto: $comando"
    aiuto
    exit 1 ;;
esac
